CREATE TABLE MovieEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    genre TEXT NOT NULL,
    type TEXT NOT NULL,
    status TEXT NOT NULL,
    rating REAL,
    review TEXT NOT NULL,
    totalEpisodes INTEGER,
    watchedEpisodes INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);

selectAllMovies:
SELECT * FROM MovieEntity ORDER BY updatedAt DESC;

-- Gunakan ini untuk TAMBAH BARU (Tanpa Parameter ID)
insertMovie:
INSERT INTO MovieEntity(title, genre, type, status, rating, review, totalEpisodes, watchedEpisodes, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Gunakan ini untuk UPDATE (Wajib Ada ID)
updateMovie:
UPDATE MovieEntity
SET title = ?, genre = ?, type = ?, status = ?, rating = ?, review = ?, totalEpisodes = ?, watchedEpisodes = ?, updatedAt = ?
WHERE id = ?;

deleteMovieById:
DELETE FROM MovieEntity WHERE id = ?;