CREATE TABLE MovieEntity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    genre TEXT NOT NULL,
    type TEXT NOT NULL,
    status TEXT NOT NULL,
    rating REAL,
    review TEXT NOT NULL,
    totalEpisodes INTEGER,
    watchedEpisodes INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL
);

selectAllMovies:
SELECT * FROM MovieEntity ORDER BY updatedAt DESC;

getMovieById:
SELECT * FROM MovieEntity WHERE id = ?;

insertMovie:
INSERT OR REPLACE INTO MovieEntity(id, title, genre, type, status, rating, review, totalEpisodes, watchedEpisodes, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteMovieById:
DELETE FROM MovieEntity WHERE id = ?;